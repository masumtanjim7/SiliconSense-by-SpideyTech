# -----------------------------------------------------------------------------
# SiliconSense by SpideyTech — Environment Configuration Template
# Copy this file to .env for local development. Never commit real secrets.
# -----------------------------------------------------------------------------

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Database (Matches infra/docker/docker-compose.yml)
POSTGRES_USER=siliconsense
POSTGRES_PASSWORD=siliconsense_dev_pw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=siliconsense_dev
POSTGRES_TEST_DB=siliconsense_test

DATABASE_URL=postgresql+psycopg://siliconsense:siliconsense_dev_pw@localhost:5432/siliconsense_dev
TEST_DATABASE_URL=postgresql+psycopg://siliconsense:siliconsense_dev_pw@localhost:5432/siliconsense_test

# Redis (Optional for MVP caching / Stage 2 Celery workers)
REDIS_URL=redis://localhost:6379/0

# FastAPI Service
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Next.js Web Frontend
NEXT_PUBLIC_APP_NAME="SiliconSense by SpideyTech"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth (Placeholders until Phase 5 / Task 5.2)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_JWT_SECRET=your-jwt-secret-placeholder